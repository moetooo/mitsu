# Mitsu Environment Configuration

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mitsu

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Optional API Keys
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Token (for rate limits & faster model downloads)
HF_TOKEN=your_huggingface_token_here

# LLM models. One id per job, and they may differ: enrichment reads a whole
# record and reasoning writes one sentence about it. Both must be ids the
# provider actually serves; a wrong one does not break a request, it silently
# removes the reasoning (one WARNING line, then debug).
LLM_MODEL=openai/gpt-oss-120b
# Optional. Falls back to LLM_MODEL when blank.
LLM_REASONING_MODEL=
LLM_REASONING_ENABLED=true
LLM_REASONING_TIMEOUT_S=5

# Logging. LOG_LEVEL=DEBUG shows tuning detail; LOG_FORMAT=json emits one object
# per line for a log shipper. Plain lines are compact on purpose: time, level,
# short logger name, message, and a request id when a request caused them.
LOG_LEVEL=INFO
LOG_FORMAT=plain

# Catalog sync (manual + once-daily external scheduler)
SYNC_ENABLED=true
# Auto starts OFF: the external scheduler's mode=auto runs are skipped until
# this is true (or the dashboard switch is turned on).
SYNC_AUTO_ENABLED=false
# Browser dashboard login. No defaults: leave both blank and the admin surface
# stays closed (503). Set them before using the dashboard.
SYNC_ADMIN_USERNAME=
SYNC_ADMIN_PASSWORD=
# Optional. If blank, the session signer derives from the credentials.
SYNC_ADMIN_SESSION_SECRET=
SYNC_ADMIN_SESSION_HOURS=12
# Set true only when the dashboard is served over HTTPS.
SYNC_ADMIN_COOKIE_SECURE=false
# Legacy token for scheduler/CLI automation. The browser dashboard uses login.
SYNC_ADMIN_TOKEN=
SYNC_EMBEDDINGS=true
SYNC_INVALIDATE_CACHE=true
SYNC_RUN_RETENTION_DAYS=30
SYNC_USAGE_RETENTION_DAYS=90
# Backfill walks AniList updates newer than this instant.
SYNC_BACKFILL_CUTOFF=2026-08-06T19:43:15+00:00

# Daily guardrails. Overrides can raise today's cap only up to the hard ceiling.
SYNC_HARD_DAILY_CEILING=60
SYNC_BACKFILL_RESERVE=5
SYNC_DAILY_RUN_LIMIT=6
SYNC_MANUAL_COOLDOWN_SECONDS=600

# Hard provider budgets. AniList is capped per day, not per minute.
ANILIST_DAILY_REQUEST_BUDGET=30
ANILIST_SYNC_PAGE_SIZE=50
ANILIST_SYNC_MAX_PAGES=3
MANGADEX_SYNC_ENABLED=true
MANGADEX_DAILY_REQUEST_BUDGET=20
MANGADEX_SYNC_BATCH_SIZE=20

# --- Cover policy ------------------------------------------------------------
# Which hosts a browser can actually load, and in what order covers are preferred.
# Reinstating a blocked host (MangaDex) is these two variables plus a restart - no
# code change. Verify a host with `scratch/cover_probe.py` before allowing it, and
# check `GET /health/covers` afterwards. A host in both lists is treated as blocked.
COVER_ALLOWED_HOSTS=s4.anilist.co,cdn.myanimelist.net,media.kitsu.app
COVER_BLOCKED_HOSTS=uploads.mangadex.org
COVER_SOURCE_ORDER=anilist,mal,kitsu,mangadex
COVER_MAX_CANDIDATES=3
# Weekly MangaDex canary (one request/week, in-process, Redis-locked).
COVER_CANARY_ENABLED=true

# Dev server port for `python -m app` (app/__main__.py). 8001, not 8000: 8000 is
# vLLM's default port and coding agents probe it every 30s for a local model
# server (GET /v1/models), which floods the request log with 404s.
API_PORT=8001
